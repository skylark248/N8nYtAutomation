# n8n YouTube Shorts Automation - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── n8n Instance ───────────────────────────────────────────
# URL where your n8n instance is running
N8N_URL=http://localhost:5678

# n8n API key (get from: n8n Settings → API → Create API Key)
N8N_API_KEY=your-n8n-api-key-here

# ─── Google AI Studio (Gemini) ───────────────────────────────
# Get from: https://aistudio.google.com/apikeys (free, no billing required)
# Used for: Script generation, image generation, voiceover TTS
# Note: This single key powers all 3 AI nodes in the workflow
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Image Generation APIs ─────────────────────────────────
# Pollinations.ai (primary): Sign up at https://auth.pollinations.ai/
# Then get secret key from https://enter.pollinations.ai/
# Free: unlimited requests with sk_ key (no rate limits)
POLLINATIONS_SECRET_KEY=your-sk-key-here

# Pexels (fallback): Sign up at https://www.pexels.com/api/
# Free: 200 requests/hour, instant approval
PEXELS_API_KEY=your-pexels-api-key-here

# ─── YouTube OAuth2 ────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret-here
