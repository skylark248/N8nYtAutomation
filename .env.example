# n8n YouTube Shorts Automation - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── n8n Instance ───────────────────────────────────────────
# URL where your n8n instance is running
N8N_URL=http://localhost:5678

# n8n API key (get from: n8n Settings → API → Create API Key)
N8N_API_KEY=your-n8n-api-key-here

# ─── Google AI Studio (Gemini) ───────────────────────────────
# Get from: https://aistudio.google.com/apikeys (free, no billing required)
# Used for: Script generation + voiceover TTS
# Note: Passed as URL query param in workflow nodes, not as env var
GEMINI_API_KEY=your-gemini-api-key-here

# ─── ComfyUI (Local AI Generation) ────────────────────────
# ComfyUI API URL (running on Windows host, reachable from Docker)
# Default: http://host.docker.internal:8188
COMFYUI_URL=http://host.docker.internal:8188

# ─── YouTube OAuth2 ────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret-here
